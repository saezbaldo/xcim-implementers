{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcim.org/schemas/0.1/event-consistency-proof.schema.json",
  "title": "XCIM 0.1 Event Consistency Proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["old_tree_size", "old_root", "new_tree_size", "new_root", "path"],
  "properties": {
    "old_tree_size": { "$ref": "#/$defs/nonnegative" },
    "old_root": { "$ref": "#/$defs/hash" },
    "new_tree_size": { "$ref": "#/$defs/nonnegative" },
    "new_root": { "$ref": "#/$defs/hash" },
    "path": {
      "type": "array", "maxItems": 256,
      "description": "Hashes in RFC6962 SUBPROOF output order.",
      "items": { "$ref": "#/$defs/hash" }
    }
  },
  "$defs": {
    "nonnegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "hash": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
